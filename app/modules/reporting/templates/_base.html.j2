{# Shared report layout: identification and provenance header. Values are escaped by the environment. #}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ meta.title }} v{{ meta.version_no }} - {{ data.project.code }}</title>
  <link rel="stylesheet" href="/app/assets/css/report.css">
</head>
<body>
  <header class="report-header">
    <p class="eyebrow">{{ data.project.code }} - {{ data.project.customer }}</p>
    <h1>{{ meta.title }}</h1>
    <p class="subtitle">{{ data.project.name }}</p>
    <dl class="meta">
      <dt>Report version</dt><dd>{{ meta.version_no }}</dd>
      <dt>Generated</dt><dd>{{ meta.generated_at }} by {{ meta.generated_by }}</dd>
      <dt>Reporting period</dt><dd>{{ data.period.from }} to {{ data.period.to or "no records yet" }}</dd>
      <dt>Project ID</dt><dd>{{ data.project.id }}</dd>
      <dt>Data</dt><dd>sha256 {{ meta.data_sha256 }}; template {{ meta.template_version }}</dd>
    </dl>
    <details class="sources">
      <summary>Data sources ({{ meta.sources | length }})</summary>
      <ul>{% for source in meta.sources %}<li>{{ source }}</li>{% endfor %}</ul>
    </details>
    <p class="notice">Generated by Agentra from recorded workflow data, documents, decisions and approvals. No figure in this
      report is written by an AI agent. Missing information is labelled as such.</p>
  </header>
  <main>
{% block content %}{% endblock %}
  </main>
</body>
</html>
